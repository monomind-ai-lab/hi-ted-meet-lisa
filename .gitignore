.DS_Store
__pycache__/
*.pyc
intake.json

# project-context trigger state (session-local, not shared)
.claude/project-context-state.json

# the context registry lives beside the checkout, reached through this
# symlink; no slash suffix so the symlink itself is ignored, not a directory
/project-context

